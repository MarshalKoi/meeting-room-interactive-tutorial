---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.svelte";
import { Image } from "astro:assets";
import roomImg from "../../assets/imgs/PHL.jpg";
import { bigRoomCards } from "../../data/big-room.js";

const base = import.meta.env.BASE_URL;
---

<Layout title="Phòng họp lớn">
  <div class="accent-green pb-16">
    <div class="page-inner">

      <a href={base} class="back-link">‹ Chọn phòng khác</a>

      <div class="room-panel">
        <div class="panel-top-bar"></div>
        <div class="panel-heading">
          <div>
            <div class="label-sm">Smart AV Room</div>
            <h1 class="room-title">PHÒNG HỌP LỚN</h1>
          </div>
          <div class="room-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
        </div>
        <div class="room-image-wrap">
          <Image
            src={roomImg}
            alt="Phòng họp lớn"
            class="room-image"
            loading="eager"
            fetchpriority="high"
          />
          <div class="image-overlay"></div>
        </div>
      </div>

      <div class="qs-panel">
        <span class="qs-tag">Khởi động hệ thống</span>
        <div class="qs-title">Bắt đầu bằng việc khởi động hệ thống</div>
        <div class="qs-steps">
          <div class="qs-step"><span class="qs-num">1</span>Bật cầu giao trong tủ điện góc bên trái phòng</div>
          <div class="qs-step"><span class="qs-num">2</span>Chờ thiết bị khởi động 5-10 phút</div>
          <div class="qs-step"><span class="qs-num">3</span>Bật TV và máy tính</div>
        </div>
      </div>

      <div class="cards-stack">
        {bigRoomCards.map((card) => (
          <Card client:visible {...card} href={`${base}/big-meeting-room/${card.slug}`} />
        ))}
      </div>

      <div class="page-footer">
        AV Control System · Hotline: <a href="tel:0853123456" class="footer-link">0853123456</a>
      </div>

    </div>
  </div>
</Layout>
