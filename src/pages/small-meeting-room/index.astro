---
import Layout from "../../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Phòng họp nhỏ">
  <div class="min-h-screen flex justify-center p-4">
    <div class="w-full max-w-md">
      <a href={base} class="inline-flex items-center gap-2 text-sm text-slate-500 hover:text-slate-800 transition-colors mt-2 mb-5">
        ‹ Chọn phòng khác
      </a>
      <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-lg text-center">
        <div class="text-4xl mb-4">🖥️</div>
        <h1 class="text-2xl font-bold mb-2">Phòng họp nhỏ</h1>
        <p class="text-slate-500 text-sm">Nội dung đang được cập nhật.</p>
      </div>
    </div>
  </div>
</Layout>
