---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.svelte";
import { Image } from "astro:assets";
import roomImg from "../../assets/imgs/PHN.jpg";

const base = import.meta.env.BASE_URL;

const cards = [
  {
    title: "Bắt đầu nhanh",
    desc: "Khởi động TV và kết nối thiết bị trong 30 giây",
    icon: "Zap",
    steps: [
      "Bật TV bằng remote hoặc nút nguồn",
      "Bật bộ hub kết nối trên bàn",
      "Chọn nguồn HDMI hoặc Wireless trên TV",
    ],
  },
  {
    title: "Trình chiếu có dây",
    desc: "Kết nối laptop qua HDMI trực tiếp",
    icon: "Plug",
    steps: [
      "Cắm cáp HDMI vào cổng trên bàn họp",
      "Cắm đầu còn lại vào laptop",
      "Chuyển nguồn TV sang HDMI tương ứng",
    ],
  },
  {
    title: "Trình chiếu không dây",
    desc: "Kết nối laptop qua ClickShare",
    icon: "Cast",
    steps: [
      "Cắm USB ClickShare vào laptop",
      "Chờ thiết bị tự nhận diện và kết nối",
      "Bấm nút ClickShare để chia sẻ màn hình",
    ],
  },
  {
    title: "Họp Teams / Zoom",
    desc: "Dùng webcam USB và loa TV cho cuộc họp",
    icon: "Video",
    steps: [
      "Cắm webcam USB vào laptop",
      "Mở Teams hoặc Zoom và chọn webcam vừa cắm",
      "Chọn loa TV hoặc loa bluetooth làm audio output",
    ],
  },
  {
    title: "Điều chỉnh âm thanh",
    desc: "Tăng giảm âm lượng loa TV hoặc loa ngoài",
    icon: "Volume2",
    steps: [
      "Dùng remote TV để điều chỉnh âm lượng",
      "Hoặc điều chỉnh volume trực tiếp trên laptop",
      "Tắt tiếng khi cần bằng nút Mute trên remote",
    ],
  },
  {
    title: "Gọi hỗ trợ kỹ thuật",
    desc: "Liên hệ bộ phận AV/IT khi cần hỗ trợ",
    icon: "Phone",
    steps: [
      "Hotline nội bộ: 1900 1234",
      "Quét QR để gửi ticket hỗ trợ",
      "Liên hệ kỹ thuật trực ca tầng 5",
    ],
  },
];
---

<Layout title="Phòng họp nhỏ">
  <div class="accent-teal pb-16">
    <div class="page-inner">

      <a href={base} class="back-link">‹ Chọn phòng khác</a>

      <div class="room-panel">
        <div class="panel-top-bar"></div>
        <div class="panel-heading">
          <div>
            <div class="label-sm">Smart AV Room</div>
            <h1 class="room-title">PHÒNG HỌP NHỎ</h1>
          </div>
          <div class="room-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
        </div>
        <div class="room-image-wrap">
          <Image
            src={roomImg}
            alt="Phòng họp nhỏ"
            class="room-image"
          />
          <div class="image-overlay"></div>
        </div>
        <div class="specs-row">
          <div class="spec-item">
            <div class="spec-value">TV</div>
            <div class="spec-label">75 inch</div>
          </div>
          <div class="spec-divider"></div>
          <div class="spec-item">
            <div class="spec-value spec-value--accent">Teams</div>
            <div class="spec-label">Ready</div>
          </div>
          <div class="spec-divider"></div>
          <div class="spec-item">
            <div class="spec-value">BYOD</div>
            <div class="spec-label">HDMI + Wireless</div>
          </div>
        </div>
      </div>

      <div class="qs-panel">
        <span class="qs-tag">Hướng dẫn nhanh</span>
        <div class="qs-title">Kết nối trong 3 bước</div>
        <div class="qs-steps">
          <div class="qs-step"><span class="qs-num">1</span>Bật TV và hub kết nối trên bàn</div>
          <div class="qs-step"><span class="qs-num">2</span>Cắm HDMI hoặc USB ClickShare</div>
          <div class="qs-step"><span class="qs-num">3</span>Chọn nguồn đầu vào trên remote TV</div>
        </div>
      </div>

      <div class="cards-stack">
        {cards.map((card) => (
          <Card client:visible {...card} />
        ))}
      </div>

      <div class="page-footer">
        AV Control System · Hotline: <a href="tel:19001234" class="footer-link">1900 1234</a>
      </div>

    </div>
  </div>
</Layout>
